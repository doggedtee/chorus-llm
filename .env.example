# ── Required ──────────────────────────────────────────────────────────────
# Get an API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Get an API key from https://app.tavily.com/
TAVILY_API_KEY=tvly-your-key-here

# ── Optional ──────────────────────────────────────────────────────────────
# Port for the API server (default 8000)
API_PORT=8000

# Port for the SQLite log query UI (default 8080)
LOGS_PORT=8080

# How often the background worker wakes up (seconds)
WORKER_POLL_SEC=30

# Set to "true" to automatically run an eval the first time the worker starts
RUN_EVAL_ON_START=false